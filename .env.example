# Export these values in your shell. The application does not read this file automatically.
# Model endpoint must implement the chat-completions JSON contract.
MIRAGE_MODEL_URL=https://approved-provider.example/v1/chat/completions
MIRAGE_MODEL_ID=approved-model
MIRAGE_MODEL_KEY=
MIRAGE_MODEL_INPUT_USD_PER_MILLION=
MIRAGE_MODEL_OUTPUT_USD_PER_MILLION=
# The worker requires a private HTTPS endpoint and an enclosing isolated Linux x86-64 VM.
MIRAGE_WORKER_URL=
MIRAGE_WORKER_TOKEN=
MIRAGE_RETENTION_DAYS=7
# Set this only for a deployed interface with HTTPS termination.
MIRAGE_PUBLIC_ORIGIN=
