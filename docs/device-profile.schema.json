{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "architecture": {
      "type": "string",
      "enum": [
        "x86_64",
        "aarch64",
        "arm",
        "riscv32",
        "custom"
      ]
    },
    "operatingSystem": {
      "type": "string",
      "enum": [
        "linux",
        "darwin",
        "bare-metal",
        "custom"
      ]
    },
    "board": {
      "default": "unknown",
      "type": "string",
      "maxLength": 200
    },
    "targetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "boardRevision": {
      "type": "string",
      "maxLength": 100
    },
    "processorPart": {
      "type": "string",
      "maxLength": 100
    },
    "abi": {
      "type": "string",
      "maxLength": 100
    },
    "byteOrder": {
      "type": "string",
      "enum": [
        "little",
        "big"
      ]
    },
    "wordBits": {
      "anyOf": [
        {
          "type": "number",
          "const": 32
        },
        {
          "type": "number",
          "const": 64
        }
      ]
    },
    "clockMHz": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "toolchain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "buildCommands": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "memoryRegions": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "kind": {
            "type": "string",
            "enum": [
              "ram",
              "flash",
              "rom"
            ]
          },
          "startBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sizeBytes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "executable": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "kind",
          "startBytes",
          "sizeBytes",
          "executable"
        ],
        "additionalProperties": false
      }
    },
    "stackLimitBytes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "maxEnergyMillijoules": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "maxSlowdown": {
      "default": 5,
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 5
    },
    "supportingFileIds": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "verificationAssumptions": {
      "default": [],
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "ramMiB": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1048576
    },
    "storageMiB": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10485760
    },
    "maxBatchMs": {
      "default": 100,
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 100
    },
    "modelPolicy": {
      "default": "auto",
      "type": "string",
      "enum": [
        "auto",
        "build-only",
        "device-requested",
        "disabled",
        "required"
      ]
    },
    "peripherals": {
      "default": [],
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 100
      }
    },
    "provenance": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "maxLength": 200
          },
          "review": {
            "type": "string",
            "enum": [
              "declared",
              "unreviewed",
              "verified"
            ]
          }
        },
        "required": [
          "source",
          "review"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "name",
    "architecture",
    "operatingSystem",
    "board",
    "maxSlowdown",
    "supportingFileIds",
    "verificationAssumptions",
    "ramMiB",
    "storageMiB",
    "maxBatchMs",
    "modelPolicy",
    "peripherals",
    "provenance"
  ],
  "additionalProperties": false
}
